# App URL (used for Stripe success/cancel redirects)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Stripe (required for $1 unlock in production)
# Get keys: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Optional — only if you add webhooks later
STRIPE_WEBHOOK_SECRET=whsec_...

# Signed httpOnly unlock cookie (use a long random string in production)
UNLOCK_COOKIE_SECRET=replace-with-long-random-secret

# Optional: polish warm reply via OpenAI (falls back to templates if unset/fails)
OPENAI_API_KEY=
